{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SkyCalib",
  "version": "2.0.0",
  "identifier": "com.skyworthxr.skycalib",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "标定测试",
        "width": 1200,
        "height": 800,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/ProcessCal",
      "resources/CheckResult"
    ]
  }
}
