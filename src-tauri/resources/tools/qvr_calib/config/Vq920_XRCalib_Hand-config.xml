<!-- Units are meters, seconds, meters/second^2 -->
<Configuration>
    <XRCalib>
        <!-- update for your device -->
        <!-- set baseline to the distance from the reference camera (the first camera listed is the reference camera) -->
        <Cameras>
            <Camera name="trackingA" radialDistortionModel="FISHEYE_4_PARAMETERS" />
            <Camera name="trackingB" radialDistortionModel="FISHEYE_4_PARAMETERS" baseline="0.099925" /> 
			<Camera name="ctrl-trackingA" radialDistortionModel="FISHEYE_4_PARAMETERS" baseline="0.047082" /> 
			<Camera name="ctrl-trackingB" radialDistortionModel="FISHEYE_4_PARAMETERS" baseline="0.122291" /> 
        </Cameras>

        <!-- use modelSelectionMode to select an appropriate camera model -->
        <ModelSelectionMode enabled="false"/>
        
        <!-- global location for appending calibration CSV summaries -->
        <Save calibrationCSVDir="..\log" />

        <Validation maximumAspectRatioErrorPercent="0.43" percentCoverageRequired="97.0" />

        <!-- set gravity magnitude if you are not in San Diego -->
        <IMU gravity="9.7833" />
    </XRCalib>
    <Cake>
        <Logging defaultLevel="debug"/>
    </Cake>
</Configuration>
